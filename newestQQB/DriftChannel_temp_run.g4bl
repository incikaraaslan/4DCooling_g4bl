            apertureRadius=281.6283447677115 \
            ironRadius=286.6283447677115 \
            gradient=-5.448298870591
            

#########################
# PLACEMENT
#########################

place Q1 z=250.000 
place Q2 z=800.000 
place Q3 z=1350.000 
place Q4 z=2150.000 
place QF1H z=2700.000 
place QD1H z=3250.000 
place QF1H z=3800.000 
place QD1H z=4350.000 
place QF1H z=4900.000 
place QD1H z=5450.000 
place QF1H z=6000.000 
place QD1H z=6550.000 
place QF1H z=7100.000 
place QD1H z=7650.000 
place QF1H z=8200.000 
place QD1H z=8750.000 
place QF1H z=9300.000 
place QD1H z=9850.000 
place QF1H z=10400.000 
place QD1H z=10950.000 
place QF1H z=11500.000 
place QD1H z=12050.000 
place QF1H z=12600.000 
place QD1H z=13150.000 
place QF1H z=13700.000 
place Q5 z=14250.000 
place Q6 z=14500.000 
place Q7 z=15050.000 
place Q8 z=15600.000 


#########################
# OUTPUT
#########################

place VD front=1 rename=$outname format=ascii z=16000
