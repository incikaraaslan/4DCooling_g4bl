            apertureRadius=281.6283447677115 \
            ironRadius=286.6283447677115 \
            gradient=-2.612044566657
            
            genericquad Q5 \
            fieldLength=150.000 \
            ironLength=150.000 \
            apertureRadius=281.6283447677115 \
            ironRadius=286.6283447677115 \
            gradient=0.174237987322
            
            genericquad Q6 \
