BEAM, particle=POSMUON, PC={avg_mom};
b_start: beta0, betx={beta_x}, bety={beta_y}, alfx={alpha_x}, alfy={alpha_y}, dx={D_x}, dpx={Dp_x}, dy={D_y},  dpy={Dp_y};
BEAM, particle=POSMUON, PC={avg_mom};

b_start: beta0,
    betx={beta_x}, bety={beta_y},
    alfx={alpha_x}, alfy={alpha_y},
    dx={D_x}, dpx={Dp_x},
    dy={D_y}, dpy={Dp_y};

! ============================================================
! ELEMENT DEFINITIONS (DEFINE ONCE)
! ============================================================

! Periodic cell quads
k_qf1 = 19;
k_qd1 = -19;

QF1h: QUADRUPOLE, L=0.075, K1:=k_qf1;
QD1h: QUADRUPOLE, L=0.075, K1:=k_qd1;

! Matching quads
k_q1 = k_qd1;
k_q2 = k_qf1;
k_q3 = k_qd1;
k_q4 = k_qf1;

k_q5 = k_q4;
k_q6 = k_q3;
k_q7 = k_q2;
k_q8 = k_q1;

Q1: QUADRUPOLE, L=0.15, K1:=k_q1;
Q2: QUADRUPOLE, L=0.15, K1:=k_q2;
Q3: QUADRUPOLE, L=0.15, K1:=k_q3;
Q4: QUADRUPOLE, L=0.15, K1:=k_q4;

Q5: QUADRUPOLE, L=0.15, K1:=k_q5;
Q6: QUADRUPOLE, L=0.15, K1:=k_q6;
Q7: QUADRUPOLE, L=0.15, K1:=k_q7;
Q8: QUADRUPOLE, L=0.15, K1:=k_q8;

! ============================================================
! PERIODIC FODO (solve once)
! ============================================================

FODO: SEQUENCE, L=1.1;
    MF0: MARKER, AT=0;
    QF1h, AT=0.0375;
    QD1h, AT=0.5125;
    QD1h, AT=0.5875;
    QF1h, AT=1.0625;
    MF1: MARKER, AT=1.1;
ENDSEQUENCE;

USE, SEQUENCE=FODO;

MATCH, SEQUENCE=FODO;
    VARY, NAME=k_qf1, STEP=1e-5;
    VARY, NAME=k_qd1, STEP=1e-5;

    CONSTRAINT, RANGE=MF1,
        BETX=TABLE(TWISS,MF0,BETX),
        BETY=TABLE(TWISS,MF0,BETY),
        ALFX=TABLE(TWISS,MF0,ALFX),
        ALFY=TABLE(TWISS,MF0,ALFY),
        DX=TABLE(TWISS,MF0,DX),
        DY=TABLE(TWISS,MF0,DY);

    SIMPLEX, CALLS=5000, TOLERANCE=1E-14;
ENDMATCH;

TWISS;

bx0f = TABLE(TWISS,MF0,BETX);
by0f = TABLE(TWISS,MF0,BETY);
ax0f = TABLE(TWISS,MF0,ALFX);
ay0f = TABLE(TWISS,MF0,ALFY);
dx0f = TABLE(TWISS,MF0,DX);
dy0f = TABLE(TWISS,MF0,DY);

b_fodo: BETA0,
    BETX=bx0f, BETY=by0f,
    ALFX=ax0f, ALFY=ay0f,
    DX=dx0f, DY=dy0f;

! ============================================================
! WHOLE MACHINE
! UP (2.775) + 10×FODO (11.0) + DOWN (2.225)
! TOTAL = 16 m
! ============================================================

WHOLE: SEQUENCE, L=16;

    ! ----------------
    ! UP SECTION
    ! ----------------
    Q1, AT=0.325;
    Q2, AT=0.875;
    Q3, AT=1.425;
    Q4, AT=1.975;

    ! Interface quad from periodic cell
    QF1h, AT=2.575;
    MFUP: MARKER, AT=2.775;

    ! ----------------
    ! 10 FODO CELLS
    ! ----------------
    FODO, AT=2.775 + 0.55;
    FODO, AT=2.775 + 1.65;
    FODO, AT=2.775 + 2.75;
    FODO, AT=2.775 + 3.85;
    FODO, AT=2.775 + 4.95;
    FODO, AT=2.775 + 6.05;
    FODO, AT=2.775 + 7.15;
    FODO, AT=2.775 + 8.25;
    FODO, AT=2.775 + 9.35;
    FODO, AT=2.775 + 10.45;

    ! ----------------
    ! DOWN SECTION
    ! ----------------
    Q5, AT=14.325;
    Q6, AT=14.575;
    Q7, AT=15.125;
    Q8, AT=15.675;

    MEND: MARKER, AT=16;

ENDSEQUENCE;

USE, SEQUENCE=WHOLE;

TWISS, FILE="madXDriftChannel/whole.tfs", BETA0=b_start;

VALUE, k_q1, k_q2, k_q3, k_q4;
VALUE, k_q5, k_q6, k_q7, k_q8;
VALUE, k_qf1, k_qd1;

STOP;