# Simulates Final Cooling Dispersion Suppressor Quadrupole

# Created by: Inci Karaaslan
# Updated: November 21, 2025

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

# VERSION HISTORY

# v304: Creates distributions at entrance of Q20 and Q21

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param maxStep=0.5

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
# physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

trackcuts keep=mu+

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

######################### DEFINE INPUT BEAM

  param -unset nparticles=12000

  param -unset beamfile=particles_after.txt

  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0  
                                   
######################### DEFINE ELEMENTS

#-------------------------------
# MAGNETS (DISPERSION SUPPRESSOR SETUP)
#-------------------------------

zntuple vd_start z=0.0 file=vd_start_dispsup.txt format=ascii require=PDGid==-13


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient=1.000000000000 \
    fieldLength=50.000000000000 \
    ironLength=50.000000000000 \
    ironRadius=10.000000000000+5.000000000000 \
    apertureRadius=10.000000000000 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4
    kill=1 \
    fringe=0

place Q1 z=241.693440239468
zntuple vd_Q1 z=266.693440239468 file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 1 between Q1 and Q2
box Drift1 width=100.000000000000 height=100.000000000000 length=20.000000000000 material=Vacuum color=0.6,0.6,0.6
place Drift1 z=276.693440239468
zntuple vd_D1 z=286.693440239468 file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient=-1.000000000000 \
    fieldLength=50.000000000000 \
    ironLength=50.000000000000 \
    ironRadius=10.000000000000+5.000000000000 \
    apertureRadius=10.000000000000 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q2 z=311.693440239468
zntuple vd_Q2 z=336.693440239468 file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13


#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
printfield type=grid file=field_cellQ2.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ=246 dZ=5