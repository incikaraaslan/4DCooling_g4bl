# Simulates Final Cooling Wedge + Dispersion Suppressor

# Wedge Created by: D. Stratakis, modified by Daniel Fu for scripted running
# Dispersion Suppressor Created by: Inci Karaaslan
# Updated: March 3, 2026

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
  param zbegin=0.0
  start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
  param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
  param fieldVoxels=400,400,400 
  param maxStep=0.5
  
  param -unset minRangeCut=1

  physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
  # physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

  trackcuts keep=mu-,mu+

  particlecolor proton=1,1,1 
  particlecolor pi+=0,1,0 
  particlecolor mu+=1,0.5,0   # orange
  particlecolor mu-=0,1,0   # green
  particlecolor e+=1,0,0      # red
  particlecolor gamma=0,0,1   # blue
  particlecolor e-=1,0.5,0    # orange

######################### DEFINE INPUT BEAM

  param -unset nparticles=12000
  param -unset beamfile=particles_before.txt
  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0  

######################### DEFINE VIRTUAL SCREENS

param VDRad=300
virtualdetector VD    radius=$VDRad    length=0.2  color=1,1,1 format=asciiExtended coordinates=centerline
                                   
######################### DEFINE WEDGE


  material Diamond1 C,1.0 density=3.51  

  param pi=3.141592654
  param degrad=$pi/180

  param -unset abshgt=11.212121838821835
  param abswidth=100
  param -unset absLEN3=24 
  param -unset abshalfangle3=47.2 
  param -unset absoffset3=3.2780759424524413
    
  
  param wedge_z=0.5*$absLEN3
     
  extrusion LHextrDS3 color=1,0,1 material=Diamond1 length=$abswidth maxStep=0.1\
  vertices='0,0; \
                 -$absLEN3/2,$absLEN3/2/tan($abshalfangle3*$degrad); \
                 -$absLEN3/2,$abshgt; \
                 0,$abshgt'

  extrusion LHextrUS3 color=1,0,1 material=Diamond1 length=$abswidth maxStep=0.1\
  vertices='0,0; \
                  0,$abshgt; \
                  $absLEN3/2,$abshgt; \
                  $absLEN3/2,$absLEN3/2/tan($abshalfangle3*$degrad)'
  
param -unset wedgeAxis=0  # 1 (or any nonzero) indicates y axis
param -unset noWedge=0  # 1 to completely remove the wedge

if $noWedge==0
if $wedgeAxis==1
    place LHextrDS3 x=0 y=$absoffset3 z=$wedge_z rotation=Z180,Y90,X00
    place LHextrUS3 x=0 y=$absoffset3 z=$wedge_z+0 rotation=Z180,Y90,X00
else
    place LHextrDS3 x=$absoffset3 y=0 z=$wedge_z rotation=Z90,Y00,X90
    place LHextrUS3 x=$absoffset3 y=0 z=$wedge_z+0 rotation=Z90,Y00,X90
endif
endif

place VD front=1 rename=particles_after_first_wedge z=$absLEN3+1

######################### DEFINE QUADS

param wedgeend=$absLEN3+1
param Drift1_kill_width=59.056592552349+2
param Drift1_kill_height=59.056592552349+2
param wall_clearance=1.0   # mm
param Drift1_kill_length=43.950950397025-2*$wall_clearance


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient=-2.556388749170 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.528296276175+5.000000000000 \
    apertureRadius=29.528296276175 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q1 z=75.000000000000
zntuple vd_Q1 z=125.000000000000 file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 1 between Q1 and Q2
box Drift1 width=59.056592552349 height=59.056592552349 length=43.950950397025 material=Vacuum color=0.6,0.6,0.6
# place Drift1 z=146.975475198512
zntuple vd_D1 z=168.950950397025 file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Killing walls for Drift 1
box Drift1_outer width=$Drift1_kill_width height=$Drift1_kill_height length=$Drift1_kill_length material=Vacuum color=1,0,0

boolean op=subtraction Drift1_wall Drift1_outer Drift1 kill=1
place Drift1_wall z=146.975475198512

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient=28.581621109048 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.528296276175+5.000000000000 \
    apertureRadius=29.528296276175 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q2 z=218.950950397025
zntuple vd_Q2 z=268.950950397025 file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13

######################### DEFINE DIPOLE
param quadsend=268.950950397025

# --- First dipole (B1)
genericsectorbend B1 \
    angle=2.0011147001062293 \
    DipoleField=0.6279613082360005 \
    fieldCenterRadius=1041.8267524076596 fieldInnerRadius=1041.8267524076596-50 fieldOuterRadius=1041.8267524076596+50 \
    fieldHeight=100 \
    ironInnerRadius=1041.8267524076596-50-1 ironOuterRadius=1041.8267524076596+50+1 \
    ironHeight=100+10 \
    maxStep=0.5 \
    fieldMaterial=Vacuum fieldColor=0,0,1 \
    ironMaterial=Fe ironColor=0.6,0.6,0.6 \
    kill=1
place B1 z=1.2787283970491108+$quadsend
corner B1_exit z=1.2787283970491108+$quadsend rotation=Y2.0011147001062293

place VD front=1 rename=vd_B1_dispsup format=ascii x=0.4056217696285588 z=37.76561146111276+$quadsend




