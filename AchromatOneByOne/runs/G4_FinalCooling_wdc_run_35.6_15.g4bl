#-------------------------------
# DETECTOR
#-------------------------------
# virtualdetector VD radius=100 color=1,0,1
# place VD  rename=VD
# zntuple VD z=983.8236996782714 file=./runs/vd_B1_end_achromat_35.6_15.txt format=ascii require=PDGid==-13  


#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
printfield type=grid file=field_cell.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ=246 dZ=5