# Simulates Final Cooling Dispersion Suppressor

# Created by: Inci Karaaslan
# Updated: November 21, 2025

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

# VERSION HISTORY

# v304: Creates distributions at entrance of Q20 and Q21

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param maxStep=0.5

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
# physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

trackcuts keep=mu+

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

# material Nb3Sn Z=38.25 A=118.25 density=8.4 state=solid

######################### DEFINE INPUT BEAM

  param -unset nparticles=2000

  param -unset beamfile=particles_before.txt

  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0  
                                   
######################### DEFINE WEDGE

  material Diamond1 C,1.0 density=3.51  

  param pi=3.141592654
  param degrad=$pi/180

  param -unset abshgt=10
  param abswidth=100
  param -unset absLEN3=18.0
  param -unset abshalfangle3=45.0 
  param -unset absoffset3=3.2     
  
  param wedge_z=0.5*$absLEN3
     
  extrusion LHextrDS3 color=1,0,1 material=Diamond1 length=$abswidth maxStep=0.1\
  vertices='0,0; \
                 -$absLEN3/2,$absLEN3/2/tan($abshalfangle3*$degrad); \
                 -$absLEN3/2,$abshgt; \
                 0,$abshgt'

  extrusion LHextrUS3 color=1,0,1 material=Diamond1 length=$abswidth maxStep=0.1\
  vertices='0,0; \
                  0,$abshgt; \
                  $absLEN3/2,$abshgt; \
                  $absLEN3/2,$absLEN3/2/tan($abshalfangle3*$degrad)'

######################### DEFINE VIRTUAL SCREENS

  param VDRad=60.0
  virtualdetector VD    radius=$VDRad    length=0.2  color=1,1,1 format=asciiExtended coordinates=centerline
   
##########################################################################################################
############################################  PLACE ELEMENTS  ############################################
##########################################################################################################

  param -unset wedgeAxis=0  # 1 (or any nonzero) indicates y axis
  param -unset noWedge=0  # 1 to completely remove the wedge
  
  if $noWedge==0
    if $wedgeAxis==1
      place LHextrDS3 x=0 y=$absoffset3 z=$wedge_z rotation=Z180,Y90,X00
      place LHextrUS3 x=0 y=$absoffset3 z=$wedge_z+0 rotation=Z180,Y90,X00
    else
      place LHextrDS3 x=$absoffset3 y=0 z=$wedge_z rotation=Z90,Y00,X90
      place LHextrUS3 x=$absoffset3 y=0 z=$wedge_z+0 rotation=Z90,Y00,X90
    endif
  endif

#-------------------------------
# MAGNETS (DISPERSION SUPPRESSOR SETUP)
#-------------------------------
# placeholders will be replaced by Python:
# B1_field: -0.7605866633209957, B1_width: 209.7621719407892, B1_height: 22.860349800060618, B1_length: 62.63460134694819, B1_z: 5990.876255631702, 
# Q1_z: 148.7791307922228, Q2_z: 2984.6642144355974, Drift1_z: 1579.9734022621694, Drift2_z: 4518.021498383407
# Q1_gradient: -1.8639284658073, Q1_length: 236.64657333901414, radius_q: 282.7796881169539, thickness: 335.4009174840655
# Q2_gradient: 1.14808891243714, Q2_length: 183.63965474597615, radius_q: 282.7796881169539

zntuple vd_start z=0.0 file=vd_start_dispsup.txt format=ascii require=PDGid==-13

zntuple vd_wedge z=25.455844122715714 file=vd_wedge_end_achromat.txt format=ascii require=PDGid==-13


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient=-1.8639284658073 \
    fieldLength=236.64657333901414 \
    ironLength=236.64657333901414 \
    ironRadius=282.7796881169539+335.4009174840655 \
    apertureRadius=282.7796881169539 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4

place Q1 z=148.7791307922228
zntuple vd_Q1 z=267.10241746172983 file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 1 between Q1 and Q2
box Drift1 width=1110.2453868051493 height=952.5380109083167 length=2625.5419696008794 material=Vacuum color=0.6,0.6,0.6
place Drift1 z=1579.9734022621694
zntuple vd_D1 z=2892.7443870626093 file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient=1.14808891243714 \
    fieldLength=183.63965474597615 \
    ironLength=183.63965474597615 \
    ironRadius=282.7796881169539+335.4009174840655 \
    apertureRadius=282.7796881169539 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4

place Q2 z=2984.6642144355974
zntuple vd_Q2 z=3076.4840418085855 file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 2 between Q2 and B1
box Drift2 width=1110.2453868051493 height=952.5380109083167 length=2882.8749131496425 material=Vacuum color=0.6,0.6,0.6
place Drift2 z=4518.021498383407

zntuple vd_D2 z=5959.458954958228 file=vd_D2_dispsup.txt format=ascii require=PDGid==-13

# --- First dipole (B1)
genericbend B1 \
    By=-0.7605866633209957 \
    fieldWidth=209.7621719407892 fieldHeight=22.860349800060618 fieldLength=62.63460134694819 \
    ironWidth=209.7621719407892+10 ironHeight=22.860349800060618+10 ironLength=62.63460134694819 \
    maxStep=0.5 \
    fieldMaterial=Vacuum fieldColor=0,0,1 \
    ironMaterial=Fe ironColor=0.6,0.6,0.6
place B1 z=5990.876255631702

zntuple vd_B1 z=6022.193556305177 file=vd_B1_dispsup.txt format=ascii require=PDGid==-13

#-------------------------------
# DETECTOR
#-------------------------------
# virtualdetector VD radius=100 color=1,0,1
# place VD  rename=VD
zntuple VD z=6032.293556305177 file=vd_dispsup.txt format=ascii require=PDGid==-13  


#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
printfield type=grid file=field_cell.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ=246 dZ=5