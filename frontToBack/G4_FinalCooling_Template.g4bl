# Simulates Final Cooling Dispersion Suppressor

# Created by: Inci Karaaslan
# Updated: December 11, 2025

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param maxStep=0.5

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
# physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

trackcuts keep=mu+

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

# material Nb3Sn Z=38.25 A=118.25 density=8.4 state=solid

######################### DEFINE INPUT BEAM

  param -unset nparticles={N_PARTICLES}

  param -unset beamfile=particles_before_new.txt

  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0.0  
                                   
######################### DEFINE WEDGE

  material Diamond1 C,1.0 density=3.51  

  param pi=3.141592654
  param degrad=$pi/180

  param -unset abshgt=2.079108542938554 
  param abswidth=100
  param -unset absLEN3=4.944980996971603
  param -unset abshalfangle3=51.32442402932793
  param -unset absoffset3=2.4724904984858016    
  
  param wedge_z=0.5*$absLEN3
     
  extrusion LHextrDS3 color=1,0,1 material=Diamond1 length=$abswidth maxStep=0.1\
  vertices='0,0; \
                 -$absLEN3/2,$absLEN3/2/tan($abshalfangle3*$degrad); \
                 -$absLEN3/2,$abshgt; \
                 0,$abshgt'

  extrusion LHextrUS3 color=1,0,1 material=Diamond1 length=$abswidth maxStep=0.1\
  vertices='0,0; \
                  0,$abshgt; \
                  $absLEN3/2,$abshgt; \
                  $absLEN3/2,$absLEN3/2/tan($abshalfangle3*$degrad)'

######################### DEFINE VIRTUAL SCREENS

  param VDRad=60.0
  virtualdetector VD    radius=$VDRad    length=0.2  color=1,1,1 format=asciiExtended coordinates=centerline
   
##########################################################################################################
############################################  PLACE ELEMENTS  ############################################
##########################################################################################################

  param -unset wedgeAxis=0  # 1 (or any nonzero) indicates y axis
  param -unset noWedge=0  # 1 to completely remove the wedge
  
  if $noWedge==0
    if $wedgeAxis==1
      place LHextrDS3 x=0 y=$absoffset3 z=$wedge_z rotation=Z180,Y90,X00
      place LHextrUS3 x=0 y=$absoffset3 z=$wedge_z+0 rotation=Z180,Y90,X00
    else
      place LHextrDS3 x=$absoffset3 y=0 z=$wedge_z rotation=Z90,Y00,X90
      place LHextrUS3 x=$absoffset3 y=0 z=$wedge_z+0 rotation=Z90,Y00,X90
    endif
  endif

#-------------------------------
# MAGNETS (DISPERSION SUPPRESSOR SETUP)
#-------------------------------
# placeholders will be replaced by Python:
# wedge_end: {wedge_end}
# B1_field: {B1_field}, B1_width: {B1_width}, B1_height: {B1_height}, B1_length: {B1_length}, B1_z: {B1_z}, 
# Q1_z: {Q1_z}, Q2_z: {Q2_z}, Drift1_z: {Drift1_z}, Drift2_z: {Drift2_z}
# Drift1_length: {Drift1_length}, Drift2_length:{Drift2_length},
# Q1_gradient: {Q1_gradient}, Q1_length: {Q1_length}, radius_q: {radius_q}, thickness: {thickness}
# Q2_gradient: {Q2_gradient}, Q2_length: {Q2_length}, radius_q: {radius_q}

zntuple vd_start z=0.0 file=vd_start_dispsup.txt format=ascii require=PDGid==-13

zntuple vd_wedge z={wedge_end} file=vd_wedge_end_achromat.txt format=ascii require=PDGid==-13


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient={Q1_gradient} \
    fieldLength={Q1_length} \
    ironLength={Q1_length} \
    ironRadius={radius_q}+{thickness} \
    apertureRadius={radius_q} \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4

place Q1 z={Q1_z}
zntuple vd_Q1 z={Q1_end} file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13


# --- Drift 1 between Q1 and Q2
box Drift1 width={Drift1_width} height={Drift1_height} length={Drift1_length} material=Vacuum color=0.6,0.6,0.6
place Drift1 z={Drift1_z}
zntuple vd_D1 z={D1_end} file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient={Q2_gradient} \
    fieldLength={Q2_length} \
    ironLength={Q2_length} \
    ironRadius={radius_q}+{thickness} \
    apertureRadius={radius_q} \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4

place Q2 z={Q2_z}
zntuple vd_Q2 z={Q2_end} file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 2 between Q2 and B1
box Drift2 width={Drift2_width} height={Drift2_height} length={Drift2_length} material=Vacuum color=0.6,0.6,0.6
place Drift2 z={Drift2_z}

zntuple vd_D2 z={D2_end} file=vd_D2_dispsup.txt format=ascii require=PDGid==-13

# --- First dipole (B1)
genericbend B1 \
    By={B1_field} \
    fieldWidth={B1_width} fieldHeight={B1_height} fieldLength={B1_length} \
    ironWidth={B1_width}+10 ironHeight={B1_height}+10 ironLength={B1_length} \
    maxStep=0.5 \
    fieldMaterial=Vacuum fieldColor=0,0,1 \
    ironMaterial=Fe ironColor=0.6,0.6,0.6
place B1 z={B1_z}

zntuple vd_B1 z={B1_end} file=vd_B1_dispsup.txt format=ascii require=PDGid==-13

#-------------------------------
# DETECTOR
#-------------------------------
# virtualdetector VD radius=50 color=1,0,1
# place VD  rename=VD
zntuple VD z={VD_z} file={VD_FILENAME} format=ascii require=PDGid==-13  


#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
printfield type=grid file=field_cell.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ={nZ} dZ=1