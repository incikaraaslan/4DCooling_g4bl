# Simulates Final Cooling Dispersion Suppressor

# Created by: Inci Karaaslan
# Updated: November 21, 2025

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

# VERSION HISTORY

# v304: Creates distributions at entrance of Q20 and Q21

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param maxStep=0.5

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
# physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

trackcuts keep=mu+

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

# material Nb3Sn Z=38.25 A=118.25 density=8.4 state=solid

######################### DEFINE INPUT BEAM

  param -unset nparticles=5000

  param -unset beamfile=particles_before.txt

  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0  
                                   
######################### DEFINE ELEMENTS

#-------------------------------
# MAGNETS (DISPERSION SUPPRESSOR SETUP)
#-------------------------------
# placeholders will be replaced by Python:
# B1_field: 0.3, B1_width: 100.0, B1_height: 100.0, B1_length: 282.0, B1_z: 771.8988793865406, 
# Q1_z: 130.49887938654047, Q2_z: 430.6988793865405, Drift1_z: 280.5988793865405, Drift2_z: 580.7988793865405
# Drift1_length: 100.0, Drift2_length:100.0,
# Q1_gradient: -3.0, Q1_length: 200.0, radius_q: 500.0, thickness: 10.0
# Q2_gradient: -6.0, Q2_length: 200.0, radius_q: 500.0

zntuple vd_start z=0.0 file=vd_start_dispsup.txt format=ascii require=PDGid==-13

zntuple vd_wedge z=30.498879386540473 file=vd_wedge_end_achromat.txt format=ascii require=PDGid==-13


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient=-3.0 \
    fieldLength=200.0 \
    ironLength=200.0 \
    ironRadius=500.0+10.0 \
    apertureRadius=500.0 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4

place Q1 z=130.49887938654047
zntuple vd_Q1 z=230.49887938654047 file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 1 between Q1 and Q2
box Drift1 width=100.0 height=100.0 length=100.0 material=Vacuum color=0.6,0.6,0.6
place Drift1 z=280.5988793865405
zntuple vd_D1 z=330.5988793865405 file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient=-6.0 \
    fieldLength=200.0 \
    ironLength=200.0 \
    ironRadius=500.0+10.0 \
    apertureRadius=500.0 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4

place Q2 z=430.6988793865405
zntuple vd_Q2 z=530.6988793865405 file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 2 between Q2 and B1
box Drift2 width=100.0 height=100.0 length=100.0 material=Vacuum color=0.6,0.6,0.6
place Drift2 z=580.7988793865405

zntuple vd_D2 z=630.7988793865405 file=vd_D2_dispsup.txt format=ascii require=PDGid==-13

# --- First dipole (B1)
genericbend B1 \
    By=0.3 \
    fieldWidth=100.0 fieldHeight=100.0 fieldLength=282.0 \
    ironWidth=100.0+10 ironHeight=100.0+10 ironLength=282.0 \
    maxStep=0.5 \
    fieldMaterial=Vacuum fieldColor=0,0,1 \
    ironMaterial=Fe ironColor=0.6,0.6,0.6
place B1 z=771.8988793865406

zntuple vd_B1 z=912.8988793865406 file=vd_B1_dispsup.txt format=ascii require=PDGid==-13

#-------------------------------
# DETECTOR
#-------------------------------
# virtualdetector VD radius=100 color=1,0,1
# place VD  rename=VD
zntuple VD z=922.9988793865406 file=vd_dispsup.txt format=ascii require=PDGid==-13  


#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
# printfield type=grid file=field_cell.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ=246 dZ=5