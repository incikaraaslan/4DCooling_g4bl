# Simulates Final Cooling Dispersion Suppressor Quadrupole

# Created by: Inci Karaaslan
# Updated: January 30, 2026

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

# VERSION HISTORY

# v304: Creates distributions at entrance of Q20 and Q21

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param maxStep=0.5

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
# physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

trackcuts keep=mu+

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

######################### DEFINE INPUT BEAM

  param nparticles=2000

  param -unset beamfile=particles_afterupt.txt
  param -unset outname=particles_after_q3.txt
  trace nTrace=1 format=ascii oneNTuple=1
  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0  
                                   
######################### DEFINE ELEMENTS

param Drift1_kill_width=59.025880355617+2
param Drift1_kill_height=59.025880355617+2
param Drift2_kill_width=59.025880355617+2
param Drift2_kill_height=59.025880355617+2

#-------------------------------
# MAGNETS (DISPERSION SUPPRESSOR SETUP)
#-------------------------------

zntuple vd_start z=0.0 file=vd_start_dispsup.txt format=ascii require=PDGid==-13


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient=60.415602787721 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.512940177808+5.000000000000 \
    apertureRadius=29.512940177808 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q1 z=75.000000000000
zntuple vd_Q1 z=125.000000000000 file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 1 between Q1 and Q2
box Drift1 width=59.025880355617 height=59.025880355617 length=10.023023872872 material=Vacuum color=0.6,0.6,0.6
place Drift1 z=130.011511936436
zntuple vd_D1 z=135.023023872872 file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Killing walls for Drift 1
box Drift1_outer width=$Drift1_kill_width height=$Drift1_kill_height length=10.023023872872 material=Vacuum color=1,0,0

boolean op=subtraction Drift1_wall Drift1_outer Drift1 kill=1
place Drift1_wall z=130.011511936436

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient=-39.283630144927 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.512940177808+5.000000000000 \
    apertureRadius=29.512940177808 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q2 z=185.023023872872
zntuple vd_Q2 z=235.023023872872 file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 2 between Q2 and Q3
box Drift2 width=59.025880355617 height=59.025880355617 length=23.217383808969 material=Vacuum color=0.6,0.6,0.6
place Drift2 z=246.631715777356
zntuple vd_D2 z=258.240407681841 file=vd_D2_dispsup.txt format=ascii require=PDGid==-13

# --- Killing walls for Drift 2
box Drift2_outer width=$Drift2_kill_width height=$Drift2_kill_height length=23.217383808969 material=Vacuum color=1,0,0

boolean op=subtraction Drift2_wall Drift2_outer Drift2 kill=1
place Drift2_wall z=246.631715777356

# --- Quadrupole (Q3)
genericquad Q3 \
    gradient=16.564048316952 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.512940177808+5.000000000000 \
    apertureRadius=29.512940177808 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q3 z=308.240407681841

zntuple vd_Q3 z=358.240407681841 file=$outname format=ascii require=PDGid==-13

#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
# printfield type=grid file=field_cellQ3.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ=246 dZ=5