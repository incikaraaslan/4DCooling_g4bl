# Simulates Final Cooling Dispersion Suppressor Quadrupole

# Created by: Inci Karaaslan
# Updated: January 30, 2026

# COLORS:  100 red, 010 green, 111 white, 110 yellow, 001 blue, 101 magenta, 011 cyan

# VERSION HISTORY

# v304: Creates distributions at entrance of Q20 and Q21

######################### DEFINE PHYSICS MODEL
 
# randomseed time
  
param zbegin=0.0
start initialZ=$zbegin  y=0.000   x=0.00   z=0.00    radiusCut=300
param steppingFormat=N,GLOBAL,CL,STEP,VOL,PROCESS,P,KE,POLAR,B
param fieldVoxels=400,400,400 
param maxStep=0.5

param -unset minRangeCut=1

physics QGSP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 minRangeCut=$minRangeCut # disable=Decay
# physics FTFP_BERT doStochastics=1 spinTracking=1 synchrotronRadiation=1 # disable=Decay

trackcuts keep=mu+

particlecolor proton=1,1,1 
particlecolor pi+=0,1,0 
particlecolor mu+=1,0.5,0   # orange
particlecolor mu-=0,1,0   # green
particlecolor e+=1,0,0      # red
particlecolor gamma=0,0,1   # blue
particlecolor e-=1,0.5,0    # orange

######################### DEFINE INPUT BEAM

  param nparticles=12000

  param -unset beamfile=particles_afterupt.txt
  param -unset outname=particles_after_q3.txt
  trace nTrace=1 format=ascii oneNTuple=1
  beam ascii filename=$beamfile nEvents=$nparticles beamZ=0  
                                   
######################### DEFINE ELEMENTS

param Drift1_kill_width=58.897316889991+2
param Drift1_kill_height=58.897316889991+2
param Drift2_kill_width=58.897316889991+2
param Drift2_kill_height=58.897316889991+2

#-------------------------------
# MAGNETS (DISPERSION SUPPRESSOR SETUP)
#-------------------------------

zntuple vd_start z=0.0 file=vd_start_dispsup.txt format=ascii require=PDGid==-13


# --- Quadrupole (Q1)
genericquad Q1 \
    gradient=-3.922943250000 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.448658444995+5.000000000000 \
    apertureRadius=29.448658444995 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q1 z=57.543072498437
zntuple vd_Q1 z=107.543072498437 file=vd_Q1_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 1 between Q1 and Q2
box Drift1 width=58.897316889991 height=58.897316889991 length=41.006190670000 material=Vacuum color=0.6,0.6,0.6
place Drift1 z=128.046167833437
zntuple vd_D1 z=148.549263168437 file=vd_D1_dispsup.txt format=ascii require=PDGid==-13

# --- Killing walls for Drift 1
box Drift1_outer width=$Drift1_kill_width height=$Drift1_kill_height length=41.006190670000 material=Vacuum color=1,0,0

boolean op=subtraction Drift1_wall Drift1_outer Drift1 kill=1
place Drift1_wall z=128.046167833437

# --- Quadrupole (Q2)
genericquad Q2 \
    gradient=23.705513690000 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.448658444995+5.000000000000 \
    apertureRadius=29.448658444995 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q2 z=198.549263168437
zntuple vd_Q2 z=248.549263168437 file=vd_Q2_dispsup.txt format=ascii require=PDGid==-13

# --- Drift 2 between Q2 and Q3
box Drift2 width=58.897316889991 height=58.897316889991 length=30.161917890000 material=Vacuum color=0.6,0.6,0.6
place Drift2 z=263.630222113437
zntuple vd_D2 z=278.711181058437 file=vd_D2_dispsup.txt format=ascii require=PDGid==-13

# --- Killing walls for Drift 2
box Drift2_outer width=$Drift2_kill_width height=$Drift2_kill_height length=30.161917890000 material=Vacuum color=1,0,0

boolean op=subtraction Drift2_wall Drift2_outer Drift2 kill=1
place Drift2_wall z=263.630222113437

# --- Quadrupole (Q3)
genericquad Q3 \
    gradient=-53.130690840000 \
    fieldLength=100.000000000000 \
    ironLength=100.000000000000 \
    ironRadius=29.448658444995+5.000000000000 \
    apertureRadius=29.448658444995 \
    maxStep=0.5 \
    ironMaterial=Fe fieldMaterial=Vacuum \
    ironColor=0.4,0.8,0.4 \
    kill=1 \
    fringe=0

place Q3 z=328.711181058437

zntuple vd_Q3 z=378.711181058437 file=$outname format=ascii require=PDGid==-13

#-------------------------------
# FIELD MAP OUTPUT
#-------------------------------
# printfield type=grid file=field_cellQ3.dat field=By X0=0 Y0=0 Z0=0 nX=1 dX=1 nY=1 dY=1 nZ=246 dZ=5