genericquad QF1h \
  fieldLength=75 \
  ironLength=75 \
  apertureRadius=300 \
  ironRadius=305 \
  gradient=$g_k_qf1

genericquad QD1h \
  fieldLength=75 \
  ironLength=75 \
  apertureRadius=300 \
  ironRadius=305 \
  gradient=$g_k_qd1

