    vary, name=k_qd1, step=.00001;

    constraint, range=MD, alfx=1, alfy=1;

    simplex, calls=1000,  tolerance=1E-13;

number of variables:    2
user given constraints: 2
total constraints:      2

START SIMPLEX:

ENDMATCH;


